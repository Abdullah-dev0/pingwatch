# Copy to .env and fill in DATABASE_URL. The other values have defaults.
NODE_ENV=development
PORT=3001

# Frontend URL(s) allowed to call the API, comma-separated. No trailing slash.
# Production example: https://monitor.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Postgres connection string. Required.
# Local: the Docker Postgres from docker-compose.yml. Never point local dev at the production database.
DATABASE_URL=postgresql://monitor:monitor@localhost:5433/monitor

# How often to ping httpbin, in ms. Default 300000 (5 minutes).
# PING_INTERVAL_MS=10000

# Gemini, for the AI chat and incident reports. Optional: without a key the AI parts show a "not configured" message.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Price per 1M tokens in USD (paid tier), only used for the cost display. Match it to the model's price:
# gemini-3.8-flash is 0.75 / 3.75 until 31 Dec 2026, then 1.5 / 7.5 (https://aistudio.google.com/docs/pricing)
# GEMINI_INPUT_USD_PER_M=0.75
# GEMINI_OUTPUT_USD_PER_M=3.75
